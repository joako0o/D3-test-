{
  "name": "central-bank-scrollytelling",
  "version": "1.0.0",
  "description": "Exploración interactiva de 16 años de reuniones de política monetaria en Chile (2000-2015). Scrollytelling con Three.js, GSAP ScrollTrigger y D3.js.",
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "build:js": "node scripts/build-js.mjs",
    "prestart": "npm run build:css && npm run build:js",
    "predev": "npm run build:css && npm run build:js",
    "start": "python3 scripts/serve.py 8000",
    "dev": "python3 scripts/serve.py 8000",
    "check": "node scripts/build-css.mjs --check && node scripts/build-js.mjs --check && node tools/smoke-test.mjs",
    "shots": "node scripts/screenshots/capture.mjs",
    "hero:check": "node scripts/screenshots/hero-check.mjs",
    "perf": "node scripts/perf/measure.mjs",
    "startup": "node scripts/perf/startup.mjs",
    "perf:early": "node scripts/perf/early-scroll.mjs",
    "perf:ambient": "node scripts/perf/ambient-parity.mjs",
    "lh": "node scripts/perf/lighthouse.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "keywords": [
    "scrollytelling",
    "three.js",
    "gsap",
    "d3.js",
    "chile",
    "central-bank",
    "monetary-policy"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@sparticuz/chromium": "^133.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.6",
    "puppeteer-core": "^24.0.0",
    "three": "^0.160.0"
  }
}
